    ac_bindings:
      - label: "AC2"
        criterion_hash: "7bd02fbbb1e5f855293c0a6c11414e34bb1ab639f9d1ec60f79cb2a629b3a01a"
        proposed_by: "lane=dod-closeout-bind-2026-10-06T2245Z-c0"
        accepted_by: "lane=dod-closeout-accept-2026-10-06T2245Z-c0"
        accepted_at: "2026-10-06T23:39:30Z"
  - id: "dod-accept-2245z-19587-ac3-operator-fallback"
    description: |-
      AC3 binding proposed by lane dod-closeout-bind-2026-10-06T2245Z-c0 and accepted by a different lane, dod-closeout-accept-2026-10-06T2245Z-c0, after an independent re-run at omniclaude origin/dev 12cdab834a5b (4 passed). With the read-token command unset or exiting non-zero, a read runs on the operator token and the record carries identity operator-fallback with its reason, at router and installed-shim level. Absent at the parents of the implementing merges.
    source: "manual"
    execution_scope: "local_done_gate"
    checks:
      - check_type: "test_passes"
        check_value: |-
          env -u PYTHONPATH uv run pytest "tests/scripts/test_gh_read_routing.py::test_fallback_when_token_cmd_unset" "tests/scripts/test_gh_read_routing.py::test_fallback_when_token_cmd_fails" "tests/scripts/test_gh_shim_read_routing.py::test_route_fallback_when_token_command_is_unset" "tests/scripts/test_gh_shim_read_routing.py::test_route_fallback_when_mint_fails" -q -p no:cacheprovider
        cwd: "${OMNI_HOME}/omniclaude"
    binds_ac:
      - "AC3"
    ac_bindings:
      - label: "AC3"
        criterion_hash: "0131b413432273f468fccac6aad39bb9fdd5f4f968096e05083682c43f0126d2"
        proposed_by: "lane=dod-closeout-bind-2026-10-06T2245Z-c0"
        accepted_by: "lane=dod-closeout-accept-2026-10-06T2245Z-c0"
        accepted_at: "2026-10-06T23:39:30Z"
  - id: "dod-accept-2245z-19587-ac4-token-cache"
    description: |-
      AC4 binding proposed by lane dod-closeout-bind-2026-10-06T2245Z-c0 and accepted by a different lane, dod-closeout-accept-2026-10-06T2245Z-c0, after an independent re-run at omniclaude origin/dev 12cdab834a5b (5 passed). The cached token file is mode 0600 and reused, re-minted past TOKEN_MAX_AGE_S, whose value is held under the mint command's guaranteed floor (below 50 minutes), and no token string reaches the usage or shim log. Absent at the parents of the implementing merges.
    source: "manual"
    execution_scope: "local_done_gate"
    checks:
      - check_type: "test_passes"
        check_value: |-
          env -u PYTHONPATH uv run pytest "tests/scripts/test_gh_read_routing.py::test_cache_file_is_mode_0600_and_reused" "tests/scripts/test_gh_read_routing.py::test_cache_expires_after_its_own_max_age" "tests/scripts/test_gh_read_routing.py::test_cache_max_age_stays_under_the_mint_commands_guaranteed_floor" "tests/scripts/test_gh_read_routing.py::test_cache_token_never_in_records_or_usage_log" "tests/scripts/test_gh_shim_read_routing.py::test_route_secret_never_logged" -q -p no:cacheprovider
        cwd: "${OMNI_HOME}/omniclaude"
    binds_ac:
